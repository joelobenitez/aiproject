# Copiar a .env y completar con valores reales. .env esta en .gitignore (D8) —
# esta es la solucion de desarrollo, no la decision de gestion de secretos de produccion
# (ver memory/risks.md).

ANTHROPIC_API_KEY=
MODEL=claude-haiku-4-5-20251001

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=aiproject
INFLUX_BUCKET=lecturas_motor

COOLDOWN_MINUTOS=15

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_BASE=demo/planta1/linea_a/motor_001
# credenciales del broker (D20/FR-009) — generar con mosquitto_passwd, ver mosquitto/passwd
MQTT_USERNAME=
MQTT_PASSWORD=

HTTP_PORT=8000
# token que debe presentar un cliente HTTP en el header X-API-Token para POST /diagnosticar
# (D20/FR-010) — elegir un valor propio, no dejar vacio
API_TOKEN=

# sin default inseguro (D20/FR-012) — Grafana no arranca si esto queda vacio
GRAFANA_ADMIN_PASSWORD=
